{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parklights-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/audio/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parklights-studija",
      "database_id": "e0d981c9-bfa2-44ec-91e4-b58c25d0a8e8"
    }
  ],
  "observability": { "enabled": true }
}
